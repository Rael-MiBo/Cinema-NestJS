{
  "expo": {
    "name": "Cinema App",
    "slug": "cinema-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cinema",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset"
    ]
  }
}
